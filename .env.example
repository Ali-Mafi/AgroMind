# Set in Vercel and locally. Never commit actual keys or session data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://agromind.ir

# Existing Resend sending key; keep its current value and verified domain.
RESEND_API_KEY=
# Generate in Supabase > Authentication > Hooks > Send Email.
# Store the same signing secret in Supabase and Vercel. Server only.
SUPABASE_AUTH_EMAIL_HOOK_SECRET=

# Native recovery codes are disabled on the current hosted Auth project.
# Leave false unless the provider enables enrollment AND the complete flow is verified.
SUPABASE_RECOVERY_CODES_ENABLED=false

# Optional username-login Turnstile widget (public site key, Vercel).
# Configure its matching secret only in Supabase Edge Function secrets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Edge Function only; do not expose these through NEXT_PUBLIC_* variables:
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=agromind.ir
